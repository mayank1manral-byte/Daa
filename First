#include <stdio.h>

int binarySearch(int train[], int n, int key)
{
    int low = 0, high = n - 1;

    while(low <= high)
    {
        int mid = (low + high) / 2;

        if(train[mid] == key)
            return mid;

        if(key < train[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    return -1;
}

int main()
{
    int train[] = {101, 205, 310, 415, 520, 625};
    int n = 6;
    int key = 415;

    int index = binarySearch(train, n, key);

    printf("Index = %d\n", index);

    return 0;
}
